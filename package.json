{
  "name": "osecbox",
  "version": "1.0.2",
  "description": "Cross-platform Electron workspace for authorized security testing, terminal workflows, scan analysis, and attack-surface documentation.",
  "author": {
    "name": "DappianLabs",
    "email": "contact@dappianlabs.com"
  },
  "type": "module",
  "main": "dist/electron/main.cjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DappianLabs/Osecbox.git"
  },
  "bugs": {
    "url": "https://github.com/DappianLabs/Osecbox/issues"
  },
  "homepage": "https://github.com/DappianLabs/Osecbox",
  "keywords": [
    "electron",
    "penetration-testing",
    "cybersecurity",
    "nmap",
    "security-tools",
    "wsl2"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"const fs=require('fs');['node_modules/.vite','dist','.vite','client/.vite'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true})}catch(e){}})\"",
    "dev:client": "vite dev --port 5002 --host 0.0.0.0",
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:electron": "node scripts/build/ensure-electron-compiled.cjs && concurrently \"npm run dev:client\" \"wait-on http://localhost:5002 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run clean && node scripts/build/application.mjs",
    "compile:electron": "tsc -p electron/tsconfig.json && node scripts/build/rename-to-cjs.cjs && node scripts/build/fix-all-requires.cjs",
    "encrypt": "node scripts/build/encrypt-modules.js",
    "encrypt:production": "node scripts/build/encrypt-modules.js production",
    "restore-plaintext": "node scripts/build/encrypt-modules.js restore",
    "rebuild:native": "node scripts/build/rebuild-native.cjs",
    "audit:platform": "node scripts/diagnostics/platform-compatibility-audit.cjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "prebuild:electron": "npm run encrypt && npm run rebuild:native",
    "postcompile:electron": "node -e \"console.log('Electron sources prepared')\"",
    "build:electron": "npm run prebuild:electron && npm run build && npm run compile:electron && npm run postcompile:electron && node scripts/build/run-electron-builder.cjs",
    "build:electron:win": "node scripts/build/verify-build-target.cjs --win && npm run prebuild:electron && npm run build && npm run compile:electron && npm run postcompile:electron && node scripts/build/run-electron-builder.cjs --win",
    "build:electron:linux": "node scripts/build/verify-build-target.cjs --linux && npm run prebuild:electron && npm run build && npm run compile:electron && npm run postcompile:electron && node scripts/build/run-electron-builder.cjs --linux",
    "build:electron:mac": "node scripts/build/verify-build-target.cjs --mac && npm run prebuild:electron && npm run build && npm run compile:electron && npm run postcompile:electron && node scripts/build/run-electron-builder.cjs --mac",
    "build:production": "node scripts/build/build-production.js",
    "build:production:win": "node scripts/build/build-production.js --win",
    "build:production:linux": "node scripts/build/build-production.js --linux",
    "build:production:mac": "node scripts/build/build-production.js --mac",
    "audit:package": "node scripts/diagnostics/packaged-artifact-audit.cjs",
    "release:checksums": "node scripts/diagnostics/write-release-checksums.cjs",
    "release:verify-checksums": "node scripts/diagnostics/verify-release-checksums.cjs",
    "release:foundation": "node scripts/diagnostics/release-foundation-check.cjs",
    "start": "cross-env NODE_ENV=production node dist/index.cjs",
    "start:electron": "npm run compile:electron && electron .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:electron-runtime": "node scripts/diagnostics/electron-runtime-smoke.cjs",
    "test:watch": "vitest",
    "check": "tsc",
    "check:electron": "tsc -p electron/tsconfig.json --noEmit",
    "db:push": "drizzle-kit push",
    "remotion:studio": "remotion studio remotion/index.ts",
    "remotion:render": "remotion render remotion/index.ts MyVideo out.mp4"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.7.0",
    "electron-updater": "^6.6.2",
    "express": "^4.22.3",
    "express-session": "^1.18.1",
    "groq-sdk": "^0.37.0",
    "jsonwebtoken": "^9.0.3",
    "memorystore": "^1.6.7",
    "node-pty": "^1.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0",
    "zod": "^3.25.76",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@electron/rebuild": "^4.0.3",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@remotion/cli": "^4.0.441",
    "@remotion/player": "^4.0.441",
    "@tanstack/react-query": "^5.60.5",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.12.0",
    "@types/passport": "^1.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "date-fns": "^3.6.0",
    "drizzle-kit": "^0.31.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "embla-carousel-react": "^8.6.0",
    "esbuild": "^0.25.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "javascript-obfuscator": "^5.3.0",
    "jsdom": "^29.0.0",
    "lucide-react": "^0.545.0",
    "lz-string": "^1.5.0",
    "next-themes": "^0.4.6",
    "openai": "^6.48.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "react-resizable-panels": "^2.1.9",
    "remotion": "^4.0.441",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.14",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.44.1",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "^7.1.9",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0",
    "webpack-obfuscator": "^3.6.0",
    "wouter": "^3.3.5",
    "zustand": "^5.0.9"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    },
    "@xmldom/xmldom": "^0.8.15",
    "fast-uri": "^3.1.6",
    "joi": "^18.2.5",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0"
  }
}

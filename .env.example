# AI Provider Configuration
# Choose ONE or configure BOTH for automatic fallback

# Option 1: Groq
# Get credentials from: https://console.groq.com
# GROQ_API_KEY=your_groq_api_key_here

# Option 2: Cloudflare Workers AI
# Account limits and pricing vary. See: https://dash.cloudflare.com/
# CLOUDFLARE_API_KEY=your_cloudflare_api_token_here
# CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# CLOUDFLARE_MODEL=@cf/openai/gpt-oss-120b

# Optional: Custom API endpoint
# API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Optional: Model selection
# AI_MODEL=llama-3.3-70b-versatile

# Server authentication (required for `npm run dev` and `npm run start`)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Optional local server port
# PORT=5000

# Database URL (required for drizzle-kit)
# Format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:password@localhost:5432/osecbox
# DATABASE_URL=postgresql://postgres:password@localhost:5432/osecbox
